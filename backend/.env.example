

# Server port (defaults to 8000)
PORT=8000

# MongoDB connection string
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGOURL="mongodb+srv://<username>:<password>@<cluster0>.xxxxx.mongodb.net/<db-name>"

# JWT secret used to sign auth tokens
JWT_SECRET="change-this-to-a-long-random-string"

# Cloudinary — used to store uploaded shop/item images
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Gmail account used to send emails (password reset OTP + delivery OTP)
# NOTE: use a Gmail App Password, NOT your normal Gmail password
EMAIL="your-email@gmail.com"
EMAIL_PASS="your-gmail-app-password"

# Razorpay — used for online payments (test keys end in `_test_`)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
